# -----------------------------------------------------------------------------

# Application result directory

results/
result/

# Matrix test output directories

ipsec_matrix_*/
ipsec_test_*/

# Packet captures

*.pcap
*.pcapng
*.cap

# Runtime / test logs

*.log
*.trace

# Generated reports

matrix_summary.csv

